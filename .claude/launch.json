{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zoomx-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "zoomx-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "zoomx-prod-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "zoomx-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "sandbox"],
      "port": 9400
    }
  ]
}
