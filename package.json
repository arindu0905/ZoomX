{
  "name": "zoomx-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "sandbox": "npx -y @wp-playground/cli@latest server --port=9400 --mount=./sandbox:/zoomx-sandbox --blueprint=./sandbox/blueprint.json",
    "presandbox": "node scripts/sandbox-keys.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
