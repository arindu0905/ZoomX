# ─────────────────────────────────────────────────────────────
# ZOOM X — environment template
# Copy to .env.local for development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser — never put a secret there.
# Use separate values per Vercel environment (Preview = sandbox, Production = live).
# ─────────────────────────────────────────────────────────────

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooCommerce (server only) — e.g. https://zoomx.lk or a staging host
WOOCOMMERCE_STORE_URL=
# REST API keys (WooCommerce → Settings → Advanced → REST API). Read/Write.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Secret entered on each WooCommerce webhook (Settings → Advanced → Webhooks)
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_REQUEST_TIMEOUT_MS=10000

# Signs storefront -> WordPress customer-auth calls (login/register/reset) to the
# zoomx-headless plugin. Must equal ZOOMX_HEADLESS_SECRET in wp-config.php. >= 32 chars.
WORDPRESS_AUTH_SECRET=

# Manual cache revalidation token
REVALIDATE_SECRET=
# ≥ 32 random chars; signs the cart session cookie. e.g. `openssl rand -base64 48`
SESSION_SECRET=

# PayHere — sandbox | live
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# WEBXPAY — only if the business requires it. sandbox | live
WEBXPAY_MODE=sandbox
WEBXPAY_API_KEY=
WEBXPAY_SECRET=

# Free-delivery progress bar in the bag/cart (LKR). Leave empty to hide it.
# Must match the "Free shipping" minimum set in WooCommerce → Settings → Shipping.
NEXT_PUBLIC_FREE_DELIVERY_FROM=
